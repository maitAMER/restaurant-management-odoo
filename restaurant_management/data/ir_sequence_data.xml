<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_restaurant_customer" model="ir.sequence">
            <field name="name">Restaurant Customer</field>
            <field name="code">restaurant.customer</field>
            <field name="prefix">CUST/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_restaurant_reservation" model="ir.sequence">
            <field name="name">Restaurant Reservation</field>
            <field name="code">restaurant.reservation</field>
            <field name="prefix">RES/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

                <!-- Payment Sequence - T14 -->
        <record id="seq_restaurant_payment" model="ir.sequence">
            <field name="name">Restaurant Payment</field>
            <field name="code">restaurant.payment</field>
            <field name="prefix">PAY/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Restaurant Order Sequence --> 
        <record id="seq_restaurant_order" model="ir.sequence"> 
            <field name="name">Restaurant Order</field> 
            <field name="code">restaurant.order</field> 
            <field name="prefix">ORD/</field>
            <field name="padding">5</field> 
            <field name="company_id" eval="False"/> 
        </record>
        
        <!--table sequence-->
        <record id="seq_restaurant_table" model="ir.sequence">
            <field name="name">Restaurant Table</field>
            <field name="code">restaurant.table</field>
            <field name="prefix">T-</field>
            <field name="padding">2</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
