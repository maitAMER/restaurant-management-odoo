    <record id="item_alfredo" model="restaurant.menu.item">
        <field name="name">Fettuccine Alfredo</field>
        <field name="category_id" ref="cat_mains"/>
        <field name="menu_section">dessert_appetizer</field>
        <field name="price">135</field>
        <field name="cost">44</field>
        <field name="allergens">Gluten, Dairy, Eggs</field>
        <field name="ingredients">Fettuccine, cream, parmesan, butter</field>
        <field name="prep_time_minutes">20</field>
    </record>
    <record id="item_tiramisu" model="restaurant.menu.item">
        <field name="name">Tiramisu</field>
        <field name="category_id" ref="cat_desserts_drinks"/>
        <field name="menu_section">dessert_appetizer</field>
        <field name="price">80</field>
        <field name="cost">27</field>
        <field name="allergens">Gluten, Dairy, Eggs</field>
        <field name="ingredients">Mascarpone, ladyfingers, espresso, cocoa</field>
        <field name="prep_time_minutes">5</field>
