    </record>
    <record id="item_pepperoni" model="restaurant.menu.item">
        <field name="name">Pepperoni Pizza</field>
        <field name="category_id" ref="cat_mains"/>
        <field name="menu_section">pizza</field>
        <field name="pizza_type">pepperoni</field>
        <field name="size">large</field>
        <field name="price">150</field>
        <field name="cost">52</field>
        <field name="allergens">Gluten, Dairy</field>
        <field name="ingredients">Dough, tomato sauce, mozzarella, pepperoni</field>
        <field name="prep_time_minutes">18</field>
