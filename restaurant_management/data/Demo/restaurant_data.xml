        <field name="price">65</field>
        <field name="cost">22</field>
        <field name="allergens">Gluten</field>
        <field name="ingredients">Toasted bread, tomato, basil, olive oil</field>
        <field name="prep_time_minutes">8</field>
    </record>
    <record id="item_garlic_bread" model="restaurant.menu.item">
        <field name="name">Garlic Bread</field>
        <field name="category_id" ref="cat_starters"/>
