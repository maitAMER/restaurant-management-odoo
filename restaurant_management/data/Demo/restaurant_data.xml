        <field name="is_available">False</field>
    </record>
    <record id="item_lemonade" model="restaurant.menu.item">
        <field name="name">Fresh Lemonade</field>
        <field name="category_id" ref="cat_desserts_drinks"/>
        <field name="menu_section">drink</field>
        <field name="price">35</field>
        <field name="cost">8</field>
        <field name="allergens"></field>
        <field name="ingredients">Lemon, mint, sugar, water</field>
