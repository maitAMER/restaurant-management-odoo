<?xml version="1.0" encoding="utf-8"?>
<!--
    Restaurant Management demo data. Loaded from the manifest's demo section.
-->
<odoo noupdate="1">

    <!-- ============================================================ -->
    <!-- 1. MENU CATEGORIES (3)                                        -->
    <!-- ============================================================ -->
    <record id="cat_starters" model="restaurant.menu.category">
        <field name="name">Starters</field>
    </record>
    <record id="cat_mains" model="restaurant.menu.category">
        <field name="name">Mains</field>
    </record>
    <record id="cat_desserts_drinks" model="restaurant.menu.category">
        <field name="name">Desserts &amp; Drinks</field>
