    <record id="item_espresso" model="restaurant.menu.item">
        <field name="name">Espresso</field>
        <field name="category_id" ref="cat_desserts_drinks"/>
        <field name="menu_section">drink</field>
        <field name="price">30</field>
        <field name="cost">7</field>
        <field name="allergens"></field>
        <field name="ingredients">Espresso coffee</field>
        <field name="prep_time_minutes">2</field>
    </record>

