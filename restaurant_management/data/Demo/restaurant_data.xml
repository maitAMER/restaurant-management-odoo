        <field name="category">refrigeration</field>
        <field name="equipment_type">fridge</field>
        <field name="serial_number">FRIDGE-1001</field>
        <field name="location">Storage room</field>
    </record>
    <record id="equipment_coffee_machine" model="restaurant.equipment">
        <field name="name">Espresso Machine</field>
        <field name="category">kitchen</field>
        <field name="equipment_type">coffee_machine</field>
        <field name="serial_number">COFFEE-1001</field>
        <field name="location">Front counter</field>
    </record>

    <record id="ticket_1" model="restaurant.equipment.maintenance">
        <field name="name">Oven inspection</field>
        <field name="equipment_id" ref="equipment_oven"/>
        <field name="description">Pizza oven not heating evenly</field>
        <field name="priority">3</field>
        <field name="urgency">3</field>
        <field name="state">submitted</field>
        <field name="request_date" eval="(DateTime.today() - timedelta(days=1)).strftime('%Y-%m-%d')"/>
    </record>
    <record id="ticket_2" model="restaurant.equipment.maintenance">
        <field name="name">Fridge seal repair</field>
        <field name="equipment_id" ref="equipment_fridge"/>
        <field name="description">Walk-in fridge door seal worn</field>
