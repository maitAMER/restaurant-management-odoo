    <!-- ============================================================ -->
    <!-- 6. RESERVATIONS (5)                                          -->
    <!-- ============================================================ -->
    <record id="reservation_1" model="restaurant.reservation">
        <field name="customer_id" ref="customer_1"/>
        <field name="table_id" ref="table_01"/>
        <field name="reservation_date" eval="(DateTime.today() - timedelta(days=5)).strftime('%Y-%m-%d 18:00:00')"/>
        <field name="guests">2</field>
        <field name="state">seated</field>
    </record>
    <record id="reservation_2" model="restaurant.reservation">
        <field name="customer_id" ref="customer_2"/>
        <field name="table_id" ref="table_02"/>
        <field name="reservation_date" eval="(DateTime.today() + timedelta(days=1)).strftime('%Y-%m-%d 19:00:00')"/>
        <field name="guests">4</field>
        <field name="state">confirmed</field>
    </record>
    <record id="reservation_3" model="restaurant.reservation">
        <field name="customer_id" ref="customer_3"/>
