    <!-- ============================================================ -->
    <!-- 8. ORDERS (8) - one per state                                 -->
    <!-- ============================================================ -->
    <!-- draft / takeaway -->
    <record id="order_1" model="restaurant.order">
        <field name="customer_id" ref="partner_1"/>
        <field name="restaurant_customer_id" ref="customer_1"/>
        <field name="order_type">takeaway</field>
        <field name="state">draft</field>
        <field name="reservation_time" eval="(DateTime.today() - timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="line_ids" eval="[(0, 0, {'menu_item_id': ref('item_pepperoni'), 'unit_price': 150, 'quantity': 1})]"/>
    </record>
    <!-- confirmed / dine-in with a table -->
    <record id="order_2" model="restaurant.order">
        <field name="customer_id" ref="partner_2"/>
        <field name="restaurant_customer_id" ref="customer_2"/>
        <field name="order_type">dine_in</field>
        <field name="table_id" ref="table_02"/>
        <field name="state">confirmed</field>
        <field name="reservation_time" eval="(DateTime.today() - timedelta(minutes=40)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="line_ids" eval="[(0, 0, {'menu_item_id': ref('item_margherita'), 'unit_price': 120, 'quantity': 2}), (0, 0, {'menu_item_id': ref('item_lemonade'), 'unit_price': 35, 'quantity': 2})]"/>
    </record>
    <!-- preparing / dine-in -->
    <record id="order_3" model="restaurant.order">
        <field name="customer_id" ref="partner_3"/>
        <field name="restaurant_customer_id" ref="customer_3"/>
        <field name="order_type">dine_in</field>
        <field name="table_id" ref="table_03"/>
        <field name="reservation_time" eval="(DateTime.today() - timedelta(minutes=25)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="line_ids" eval="[(0, 0, {'menu_item_id': ref('item_alfredo'), 'unit_price': 135, 'quantity': 1}), (0, 0, {'menu_item_id': ref('item_bruschetta'), 'unit_price': 65, 'quantity': 1})]"/>
    </record>
    <!-- ready / delivery with a driver -->
    <record id="order_4" model="restaurant.order">
        <field name="customer_id" ref="partner_4"/>
        <field name="restaurant_customer_id" ref="customer_4"/>
        <field name="order_type">delivery</field>
        <field name="driver_id" ref="user_driver1"/>
        <field name="delivery_address">12 Nile Corniche, Maadi, Cairo</field>
        <field name="delivery_fee">30</field>
        <field name="reservation_time" eval="(DateTime.today() - timedelta(minutes=15)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="line_ids" eval="[(0, 0, {'menu_item_id': ref('item_pepperoni'), 'unit_price': 150, 'quantity': 2})]"/>
    </record>
    <!-- completed / delivery with an overdue pending payment (10 days old) -->
    <record id="order_5" model="restaurant.order">
        <field name="customer_id" ref="partner_5"/>
        <field name="restaurant_customer_id" ref="customer_5"/>
        <field name="order_type">delivery</field>
        <field name="driver_id" ref="user_driver1"/>
        <field name="delivery_address">5 Tahrir Square, Downtown, Cairo</field>
        <field name="delivery_fee">30</field>
        <field name="payment_status">overdue</field>
        <field name="next_payment_date" eval="(DateTime.today() - timedelta(days=10)).strftime('%Y-%m-%d')"/>
        <field name="days_overdue">10</field>
        <field name="reservation_time" eval="(DateTime.today() - timedelta(days=10)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="line_ids" eval="[(0, 0, {'menu_item_id': ref('item_margherita'), 'unit_price': 120, 'quantity': 3})]"/>
    </record>
    <!-- completed / dine-in, paid with TWO split payments -->
    <record id="order_6" model="restaurant.order">
        <field name="customer_id" ref="partner_2"/>
        <field name="restaurant_customer_id" ref="customer_2"/>
        <field name="order_type">dine_in</field>
        <field name="table_id" ref="table_04"/>
        <field name="reservation_time" eval="(DateTime.today() - timedelta(days=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="line_ids" eval="[(0, 0, {'menu_item_id': ref('item_alfredo'), 'unit_price': 135, 'quantity': 2}), (0, 0, {'menu_item_id': ref('item_garlic_bread'), 'unit_price': 45, 'quantity': 2})]"/>
    </record>
    <!-- cancelled (its payment gets refunded) -->
    <record id="order_7" model="restaurant.order">
        <field name="customer_id" ref="partner_3"/>
        <field name="restaurant_customer_id" ref="customer_3"/>
        <field name="order_type">takeaway</field>
        <field name="reservation_time" eval="(DateTime.today() - timedelta(days=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="line_ids" eval="[(0, 0, {'menu_item_id': ref('item_margherita'), 'unit_price': 120, 'quantity': 1})]"/>
    </record>
    <!-- no_show -->
    <record id="order_8" model="restaurant.order">
        <field name="customer_id" ref="partner_4"/>
        <field name="restaurant_customer_id" ref="customer_4"/>
        <field name="order_type">dine_in</field>
        <field name="table_id" ref="table_01"/>
        <field name="reservation_time" eval="(DateTime.today() - timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="line_ids" eval="[(0, 0, {'menu_item_id': ref('item_espresso'), 'unit_price': 30, 'quantity': 2})]"/>
    </record>

    <!-- Add lines while the orders are draft, then apply their final states. -->
    <record id="order_3" model="restaurant.order">
        <field name="state">preparing</field>
    </record>
    <record id="order_4" model="restaurant.order">
        <field name="state">ready</field>
    </record>
    <record id="order_5" model="restaurant.order">
        <field name="state">completed</field>
    </record>
    <record id="order_6" model="restaurant.order">
        <field name="state">completed</field>
    </record>
    <record id="order_7" model="restaurant.order">
        <field name="state">cancelled</field>
    </record>
    <record id="order_8" model="restaurant.order">
        <field name="state">no_show</field>
    </record>

    <!-- ============================================================ -->
    <!-- 9. PAYMENTS (5)                                               -->
    <!-- ============================================================ -->
    <!-- order_3: paid by card -->
    <record id="payment_1" model="restaurant.payment">
        <field name="order_id" ref="order_3"/>
        <field name="tip_amount">15</field>
        <field name="method">card</field>
        <field name="state">paid</field>
    </record>
    <!-- order_4: paid cash -->
    <record id="payment_2" model="restaurant.payment">
        <field name="order_id" ref="order_4"/>
        <field name="tip_amount">20</field>
        <field name="method">cash</field>
        <field name="state">paid</field>
    </record>
    <!-- order_5: pending payment keeps the overdue account visible -->
    <record id="payment_3" model="restaurant.payment">
        <field name="order_id" ref="order_5"/>
        <field name="tip_amount">0</field>
        <field name="method">wallet</field>
        <field name="state">pending</field>
    </record>
    <!-- order_6: balanced split payment (including tip) -->
    <record id="payment_4" model="restaurant.payment">
        <field name="order_id" ref="order_6"/>
        <field name="tip_amount">10</field>
        <field name="payment_type">split</field>
        <field name="split_line_ids" eval="[(0, 0, {'method': 'cash', 'amount': 250}), (0, 0, {'method': 'card', 'amount': 170.4})]"/>
        <field name="state">paid</field>
    </record>
    <!-- order_7 (cancelled): REFUNDED -->
    <record id="payment_6" model="restaurant.payment">
        <field name="order_id" ref="order_7"/>
        <field name="tip_amount">0</field>
        <field name="method">card</field>
        <field name="state">refunded</field>
        <field name="refunded_by" ref="user_manager"/>
        <field name="refunded_at" eval="(DateTime.today() - timedelta(days=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

