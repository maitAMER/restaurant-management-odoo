<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groups -->
    <record id="group_restaurant_user" model="res.groups">
        <field name="name">Restaurant User (Waiter/Driver)</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_shift_manager" model="res.groups">
        <field name="name">Shift Manager</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('restaurant_management.group_restaurant_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root'))]"/>
    </record>

    <record id="group_restaurant_cashier" model="res.groups">
        <field name="name">Restaurant Cashier</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('restaurant_management.group_restaurant_user'))]"/>
    </record>

    <!-- Portal: customer sees only his orders/payments - T042 -->
    <record id="rule_customer_portal_orders" model="ir.rule">
        <field name="name">Customer: see only own orders</field>
        <field name="model_id" ref="model_restaurant_order"/>
        <field name="domain_force">[('restaurant_customer_id.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_customer_portal_payments" model="ir.rule">
        <field name="name">Customer: see only own payments</field>
        <field name="model_id" ref="model_restaurant_payment"/>
        <field name="domain_force">[('customer_id.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <!-- T045: Driver sees only his delivery orders -->
    <record id="rule_driver_delivery_queue" model="ir.rule">
        <field name="name">Driver: only own deliveries</field>
        <field name="model_id" ref="model_restaurant_order"/>
        <field name="domain_force">[('driver_id','=',user.id),('order_type','=','delivery')]</field>
        <field name="groups" eval="[(4, ref('restaurant_management.group_restaurant_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>