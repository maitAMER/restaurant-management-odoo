<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Customer -->
    <record id="view_customer_tree" model="ir.ui.view">
        <field name="name">restaurant.customer.tree</field>
        <field name="model">restaurant.customer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="phone"/>
            </tree>
        </field>
    </record>

    <record id="action_pizza_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">restaurant.customer</field>
        <field name="view_mode">tree</field>
    </record>


    <!-- Pizza Category -->
    <record id="view_pizza_category_tree" model="ir.ui.view">
        <field name="name">restaurant.pizza.category.tree</field>
        <field name="model">restaurant.pizza.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_pizza_category" model="ir.actions.act_window">
        <field name="name">Pizza Categories</field>
        <field name="res_model">restaurant.pizza.category</field>
        <field name="view_mode">tree</field>
    </record>


    <!-- Pizza -->
    <record id="view_pizza_tree" model="ir.ui.view">
        <field name="name">restaurant.pizza.tree</field>
        <field name="model">restaurant.pizza</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="category_id"/>
                <field name="price"/>
            </tree>
        </field>
    </record>

    <record id="action_pizza" model="ir.actions.act_window">
        <field name="name">Pizzas abo yassin</field>
        <field name="res_model">restaurant.pizza</field>
        <field name="view_mode">tree</field>
    </record>


    <!-- Tables -->
    <record id="view_pizza_table_tree" model="ir.ui.view">
        <field name="name">restaurant.table.tree</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="capacity"/>
            </tree>
        </field>
    </record>

    <record id="action_pizza_table" model="ir.actions.act_window">
        <field name="name">Tables</field>
        <field name="res_model">restaurant.table</field>
        <field name="view_mode">tree</field>
    </record>


    <!-- Chefs -->
    <record id="view_pizza_chef_tree" model="ir.ui.view">
        <field name="name">restaurant.chef.tree</field>
        <field name="model">restaurant.chef</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="speciality"/>
            </tree>
        </field>
    </record>

    <record id="action_pizza_chef" model="ir.actions.act_window">
        <field name="name">Chefs</field>
        <field name="res_model">restaurant.chef</field>
        <field name="view_mode">tree</field>
    </record>


    <!-- Order -->
    <record id="view_order_tree" model="ir.ui.view">
        <field name="name">restaurant.order.tree</field>
        <field name="model">restaurant.order</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="total_amount"/>
            </tree>
        </field>
    </record>

    <record id="action_pizza_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">restaurant.order</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>
