<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reservation Reminder Email Template -->
    <record id="email_template_reservation_reminder" model="mail.template">

        <field name="name">Restaurant Reservation Reminder</field>

        <field name="model_id" ref="model_restaurant_reservation"/>

        <field name="subject">Reservation Reminder - {{ object.name }}</field>

        <field name="email_to">{{ object.customer_id.email or '' }}</field>

        <field name="body_html" type="html">
            <div>
                <p>
                    Hello
                    <t t-out="object.customer_id.name or 'Customer'"/>,
                </p>

                <p>
                    This is a friendly reminder about your upcoming
                    restaurant reservation.
                </p>

                <p>
                    <strong>Reservation:</strong>
                    <t t-out="object.name"/>
                </p>

                <p>
                    <strong>Table:</strong>
                    <t t-out="object.table_id.display_name or ''"/>
                </p>

                <p>
                    <strong>Reservation Date:</strong>
                    <t t-out="object.reservation_date"/>
                </p>

                <p>
                    <strong>Guests:</strong>
                    <t t-out="object.guests"/>
                </p>

                <p>We look forward to welcoming you!</p>

                <p>
                    Best regards,<br/>
                    Restaurant Team
                </p>
            </div>
        </field>

        <field name="auto_delete" eval="False"/>

    </record>


    <!-- Reservation reminder cron -->
    <record id="ir_cron_reservation_reminder" model="ir.cron">

        <field name="name">Restaurant: Reservation Reminders</field>

        <field name="model_id" ref="model_restaurant_reservation"/>

        <field name="state">code</field>

        <field name="code">model._cron_send_reservation_reminders()</field>

        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>

        <field name="active" eval="True"/>

    </record>


    <!-- Automatic NO-SHOW flagging -->
    <record id="ir_cron_reservation_no_show" model="ir.cron">

        <field name="name">Restaurant: Flag No-show Reservations</field>

        <field name="model_id" ref="model_restaurant_reservation"/>

        <field name="state">code</field>

        <field name="code">model._cron_flag_no_show_reservations()</field>

        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>

        <field name="active" eval="True"/>

    </record>

</odoo>