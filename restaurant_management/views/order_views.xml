<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--Orders List View-->
    <record id="view_order_tree" model="ir.ui.view">
        <field name="name">order.tree</field>
        <field name="model">restaurant.order</field>
        <field name="arch" type="xml">

            <tree string="Orders">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="date_order"/>
                <field name="order_type"/>
                <field name="total_amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!--Orders Form View-->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">restaurant.order.form</field>
        <field name="model">restaurant.order</field>
        <field name="arch" type="xml">
            <form string="Order">
                <header>

                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>

                    <button name="action_prepare" type="object" string="Start Preparing" class="btn-secondary" invisible="state != 'confirmed'"/>

                    <button name="action_ready" type="object" string="Ready" class="btn-success" invisible="state != 'preparing'"/>
                    
                    <button name="action_deliver" type="object" string="Deliver" class="btn-success" invisible="state != 'ready'"/>

                    <button name="action_cancel" type="object" string="Cancel" class="btn-success" invisible="state in ['delivered', 'cancelled']"/>  

                    <field name="state" widget="statusbar"
                       statusbar_visible="draft,confirmed,preparing,ready,delivered,cancelled"/>

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group> 
                        <group>
                            <field name="customer_id"/>
                            <field name="date_order"/>
                        </group>
                        <group>
                            <field name="order_type"/>
                            <field name="total_amount" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_restaurant_orders" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">restaurant.order</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>

    