<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Kitchen Kanban View -->
    <record id="view_restaurant_order_kitchen_kanban" model="ir.ui.view">

        <field name="name">restaurant.order.kitchen.kanban</field>
        <field name="model">restaurant.order</field>

        <field name="arch" type="xml">

            <kanban default_group_by="state">

                <!-- Fields -->
                <field name="name"/>
                <field name="customer_id"/>
                <field name="order_type"/>
                <field name="reservation_time"/>
                <field name="state"/>
                <field name="order_items"/>
                <field name="total_amount"/>
                <field name="notes"/>

                <templates>

                    <!-- Kanban Card -->
                    <t t-name="kanban-box">

                        <div class="oe_kanban_card">

                            <!-- Order Number -->
                            <h3>
                                <field name="name"/>
                            </h3>

                            <!-- Customer -->
                            <p>
                                <strong>Customer:</strong>
                                <field name="customer_id"/>
                            </p>

                            <!-- Order Type -->
                            <p>
                                <strong>Type:</strong>
                                <field name="order_type"/>
                            </p>

                            <!-- Reservation Time -->
                            <p>
                                <strong>Time:</strong>
                                <field name="reservation_time"/>
                            </p>

                            <hr/>

                            <!-- Order Items -->
                            <strong>Items:</strong>

                            <p>
                                <field name="order_items"/>
                            </p>

                            <!-- Notes -->
                            <p t-if="record.notes.raw_value">
                                <strong>Notes:</strong>
                                <field name="notes"/>
                            </p>

                            <hr/>

                            <!-- Total -->
                            <p>
                                <strong>Total:</strong>
                                <field name="total_amount"/>
                            </p>

                            <!-- Start Preparing -->
                            <button
                                name="action_prepare"
                                type="object"
                                string="Start Preparing"
                                class="btn btn-primary"
                                invisible="state != 'confirmed'"
                            />

                            <!-- Mark Ready -->
                            <button
                                name="action_ready"
                                type="object"
                                string="Mark Ready"
                                class="btn btn-success"
                                invisible="state != 'preparing'"
                            />

                            <!-- Complete -->
                            <button
                                name="action_complete"
                                type="object"
                                string="Complete"
                                class="btn btn-success"
                                invisible="state != 'ready'"
                            />

                        </div>

                    </t>

                </templates>

            </kanban>

        </field>

    </record>


    <!-- Kitchen Action -->
    <record id="action_restaurant_kitchen" model="ir.actions.act_window">

        <field name="name">Kitchen</field>

        <field name="res_model">restaurant.order</field>

        <field name="view_mode">kanban</field>

        <field
            name="view_id"
            ref="view_restaurant_order_kitchen_kanban"
        />

        <!-- Kitchen works with active orders -->
        <field name="domain">
            [
                ('state', 'in', ['confirmed', 'preparing', 'ready'])
            ]
        </field>

        <field name="context">
            {
                'group_by': ['state']
            }
        </field>

    </record>

</odoo>



