<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_equipment_maintenance_tree" model="ir.ui.view">
        <field name="name">restaurant.equipment.maintenance.tree</field>
        <field name="model">restaurant.equipment.maintenance</field>
        <field name="arch" type="xml">
            <tree string="Maintenance Tickets"
                  decoration-success="state == 'done'"
                  decoration-warning="state == 'in_progress'">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="equipment_type"/>
                <field name="scheduled_date"/>
                <field name="urgency" widget="priority"/>
                <field name="assigned_to"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-warning="state == 'in_progress'"
                       decoration-primary="state == 'assigned'"
                       decoration-success="state == 'done'"/>
                <field name="actual_cost" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_restaurant_equipment_maintenance_form" model="ir.ui.view">
        <field name="name">restaurant.equipment.maintenance.form</field>
        <field name="model">restaurant.equipment.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance Ticket">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_open_assign_wizard" type="object" string="Assign Technician"
                            class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_start" type="object" string="Start Work"
                            class="oe_highlight" invisible="state != 'assigned'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ['done', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,assigned,in_progress,done,cancelled" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Oven temperature issue" readonly="state == 'done'"/></h1>
                    </div>
                    <group>
                        <group string="Ticket Details">
                            <field name="equipment_id" readonly="state == 'done'"/>
                            <field name="equipment_type"/>
                            <field name="request_date" readonly="state == 'done'"/>
                            <field name="scheduled_date" readonly="state in ['done', 'cancelled']"/>
                            <field name="urgency" widget="priority" required="1" readonly="state == 'done'"/>
                        </group>
                        <group string="Assignment">
                            <field name="assigned_to" readonly="1"/>
                            <field name="completed_date" readonly="1"/>
                            <field name="actual_cost" required="1" readonly="state == 'done'"/>
                        </group>
                    </group>
                    <group string="Issue Description">
                        <field name="description" placeholder="Describe the issue and repair work..." readonly="state == 'done'"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_restaurant_equipment_maintenance_search" model="ir.ui.view">
        <field name="name">restaurant.equipment.maintenance.search</field>
        <field name="model">restaurant.equipment.maintenance</field>
        <field name="arch" type="xml">
            <search string="Search Maintenance Tickets">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="assigned_to"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="assigned" string="Assigned" domain="[('state', '=', 'assigned')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="urgent" string="Urgent" domain="[('urgency', '=', '3')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter name="group_technician" string="Technician" context="{'group_by': 'assigned_to'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_urgency" string="Urgency" context="{'group_by': 'urgency'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_restaurant_equipment_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">restaurant.equipment.maintenance</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_restaurant_equipment_maintenance_search"/>
    </record>

    <record id="action_restaurant_equipment_assign_wizard" model="ir.actions.act_window">
        <field name="name">Assign Technician</field>
        <field name="res_model">restaurant.equipment.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_restaurant_equipment_maintenance"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
