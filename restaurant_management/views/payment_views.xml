<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Payments List -->
    <record id="view_restaurant_payment_list" model="ir.ui.view">
        <field name="name">restaurant.payment.list</field>
        <field name="model">restaurant.payment</field>
        <field name="arch" type="xml">
            <tree string="Payments">
                <field name="name"/>
                <field name="order_id"/>
                <field name="customer_id"/>
                <field name="payment_date"/>
                <field name="amount"/>
                <field name="method"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Payment Form -->
    <record id="view_restaurant_payment_form" model="ir.ui.view">
        <field name="name">restaurant.payment.form</field>
        <field name="model">restaurant.payment</field>
        <field name="arch" type="xml">
            <form string="Payment">

                <header>
                    <button
                        name="action_post"
                        type="object"
                        string="Confirm Payment"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel Payment"
                        invisible="state != 'posted'"
                    />

                    <button
                        name="action_draft"
                        type="object"
                        string="Reset to Draft"
                        invisible="state != 'cancelled'"
                    />

                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="True"/>
                            <field
                                name="order_id"
                                domain="[('state', '!=', 'cancelled'), ('payment_ids', '=', False)]"
                                readonly="state != 'draft'"
                            />
                            <field name="customer_id"/>
                        </group>

                        <group>
                            <field
                                name="payment_date"
                                readonly="state != 'draft'"
                            />
                            <field 
                                name="amount"
                                 readonly="1"
                            />
                            <field
                                name="method"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="reference"
                                readonly="state != 'draft'"
                            />
                        </group>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <!-- Payments Action -->
    <record id="action_restaurant_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">restaurant.payment</field>
        <field name="view_mode">list,form</field>
    </record>



</odoo>