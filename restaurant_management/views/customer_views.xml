<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_customer_tree" model="ir.ui.view">
        <field name="name">restaurant.customer.tree</field>
        <field name="model">restaurant.customer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="customer_type"/>
                <field name="mobile"/>
                <field name="email" optional="show"/>
                <field name="loyalty_points"/>
            </tree>
        </field>
    </record>

    <record id="view_restaurant_customer_search" model="ir.ui.view">
        <field name="name">restaurant.customer.search</field>
        <field name="model">restaurant.customer</field>
        <field name="arch" type="xml">
            <search string="Search Customers">
                <field name="name"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="company_tax_id" string="Company Tax ID"/>
                <filter name="individual" string="Individuals" domain="[('customer_type', '=', 'individual')]"/>
                <filter name="corporate" string="Corporate" domain="[('customer_type', '=', 'corporate')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_customer_type" string="Customer Type" context="{'group_by': 'customer_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_restaurant_customer_kanban" model="ir.ui.view">
        <field name="name">restaurant.customer.kanban</field>
        <field name="model">restaurant.customer</field>
        <field name="arch" type="xml">
            <kanban string="Customers">
                <field name="name"/>
                <field name="image_1920"/>
                <field name="customer_type"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="loyalty_points"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_card">
                            <div class="d-flex align-items-center gap-3">
                                <img t-if="record.image_1920.raw_value"
                                     t-att-src="kanban_image('restaurant.customer', 'image_1920', record.id.raw_value)"
                                     class="rounded-circle" style="width: 64px; height: 64px; object-fit: cover;" alt="Customer image"/>
                                <div t-else="" class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                    <i class="fa fa-user text-muted"/>
                                </div>
                                <div class="flex-grow-1">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="text-muted"><field name="customer_type"/></div>
                                </div>
                            </div>
                            <div class="mt-3" t-if="record.mobile.raw_value"><i class="fa fa-phone me-2"/><field name="mobile"/></div>
                            <div t-if="record.email.raw_value"><i class="fa fa-envelope me-2"/><field name="email"/></div>
                            <div class="mt-2" t-if="record.customer_type.raw_value == 'individual'">
                                <span class="badge text-bg-info"><field name="loyalty_points"/> points</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_restaurant_customer_form" model="ir.ui.view">
        <field name="name">restaurant.customer.form</field>
        <field name="model">restaurant.customer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="Customer Name" class="oe_edit_only" invisible="customer_type != 'individual'"/>
                        <label for="name" string="Company Name" class="oe_edit_only" invisible="customer_type != 'corporate'"/>
                        <h1>
                            <field name="name" placeholder="Customer or company name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="customer_type" widget="radio" options="{'horizontal': true}" nolabel="1"/>
                    </group>
                    <group>
                    <group string="Primary Contact" invisible="customer_type != 'corporate'">
                            <field name="contact_person"/>
                            <field name="contact_person_mobile"/>
                        </group>
                        <group string=" Corp Contact Details">
                            <field name="mobile" placeholder="e.g. +20 100 123 4567"/>
                            <field name="email" widget="email" placeholder="name@example.com"/>
                            <field name="address" placeholder="Customer or company address"/>
                        </group>
                        <group string="Loyalty" invisible="customer_type != 'individual'">
                            <field name="loyalty_points"/>
                            <button name="action_open_loyalty_wizard" type="object" string="Adjust Points" class="oe_link" icon="fa-gift" invisible="not id"/>
                        </group>
                    </group>

                    <group string="Corporate Information" invisible="customer_type != 'corporate'">
                        <group>
                            <field name="company_tax_id"/>
                            <field name="company_website" widget="url" placeholder="https://example.com"/>
                        </group>

                    </group>

                    <notebook>
                        <page string="Loyalty History" invisible="customer_type != 'individual'">
                            <field name="loyalty_transaction_ids" nolabel="1">
                                <tree create="0" edit="0" delete="1">
                                    <field name="date"/>
                                    <field name="reason"/>
                                    <field name="points_delta"/>
                                    <field name="balance_after"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_restaurant_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">restaurant.customer</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_restaurant_customer_search"/>
    </record>

    <record id="view_restaurant_customer_loyalty_wizard_form" model="ir.ui.view">
        <field name="name">restaurant.customer.loyalty.wizard.form</field>
        <field name="model">restaurant.customer.loyalty.wizard</field>
        <field name="arch" type="xml">
            <form string="Adjust Loyalty Points">
                <group>
                    <field name="customer_id"/>
                    <field name="points_delta"/>
                    <field name="reason" placeholder="e.g. Purchase reward or points redemption"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
