<!-- Tables -->
<odoo>

    <!-- Action -->
    <record id="action_table" model="ir.actions.act_window">
        <field name="name">Tables</field>
        <field name="res_model">restaurant.table</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <!-- Tree view -->
   <record id="view_table_tree" model="ir.ui.view">
        <field name="name">restaurant.table.tree</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <tree string="Restaurant Tables">
                <field name="name"/>
                <field name="capacity"/>
                <field name="location"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
   <record id="view_table_form" model="ir.ui.view">
        <field name="name">restaurant.table.form</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <form string="Restaurant Table">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. T-01"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Table Information">
                            <field name="capacity"/>
                            <field name="location"/>
                        </group>

                        <group string="Status">
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


</odoo>
