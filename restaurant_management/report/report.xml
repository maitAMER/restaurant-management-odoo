<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_order_receipt" model="ir.actions.report">
        <field name="name">Order Receipt</field>
        <field name="model">restaurant.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">restaurant_management.report_order_receipt_document</field>
        <field name="report_file">restaurant_management.report_order_receipt_document</field>
        <field name="print_report_name">'Receipt - %s' % (object.name or 'Order').replace('/', '-')</field>
        <field name="binding_model_id" ref="model_restaurant_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>