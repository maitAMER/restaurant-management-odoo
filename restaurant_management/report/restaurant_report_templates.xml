<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_order_receipt_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-size: 12px;">
                        <div class="text-center mb-4">
                            <h2 style="margin-bottom: 4px;">Order Receipt</h2>
                            <div>
                                <strong t-out="o.name or 'Order'"/>
                            </div>
                            <div>
                                <span t-field="o.date_order"/>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Customer</strong>
                                <div t-out="o.customer_id.name or 'Walk-in Customer'"/>
                                <div t-if="o.customer_id.mobile">
                                    <span t-field="o.customer_id.mobile"/>
                                </div>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Order Type</strong>
                                <div t-field="o.order_type"/>
                                <div>
                                    <strong>Status: </strong>
                                    <span t-field="o.state"/>
                                </div>
                            </div>
                        </div>

                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td t-out="line.menu_item_id.name"/>
                                    <td class="text-end">
                                        <span t-field="line.quantity"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="line.unit_price"
                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="line.price_subtotal"
                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                                <tr t-if="not o.line_ids">
                                    <td colspan="4" class="text-center text-muted">
                                        No items on this order.
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="3" class="text-end">Order Total</th>
                                    <th class="text-end">
                                        <span t-out="o.total_amount"
                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>

                        <div t-if="o.payment_ids" class="mt-4">
                            <h4>Payments</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Date</th>
                                        <th>Method</th>
                                        <th>Status</th>
                                        <th class="text-end">Paid</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.payment_ids" t-as="payment">
                                        <td t-out="payment.name"/>
                                        <td>
                                            <span t-field="payment.payment_date"/>
                                        </td>
                                        <td>
                                            <t t-if="payment.payment_type == 'split'">
                                                <span t-foreach="payment.split_line_ids"
                                                      t-as="split_line">
                                                    <span t-field="split_line.method"/>
                                                    <t t-if="not split_line_last">, </t>
                                                </span>
                                            </t>
                                            <span t-else="" t-field="payment.method"/>
                                        </td>
                                        <td>
                                            <span t-field="payment.state"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="payment.total_amount"
                                                  t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div t-if="o.notes" class="mt-3">
                            <strong>Notes</strong>
                            <div t-field="o.notes"/>
                        </div>

                        <div class="text-center mt-4">
                            <strong>Thank you for your visit!</strong>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>